{
  // Reisebegleitung – eigenständige App (Cloudflare Workers + D1). Anleitung: README.md im Repo-Hauptordner.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "reisebegleitung",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Eigene Domain (optional): "routes": [{ "pattern": "reise.example.org", "custom_domain": true }],
  "vars": {
    // PFLICHT (Nutzungsregeln Transitous): Kontakt für den User-Agent – E-Mail-Adresse oder URL,
    // z. B. "https://github.com/<du>/reisebegleitung" oder "reise@example.org". Ohne Kontakt keine Fahrplandaten.
    "CONTACT": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reisebegleitung",
      // Ausgabe von: npx wrangler d1 create reisebegleitung
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Anmelde-Versuche pro IP begrenzen (namespace_id: beliebige Zahl, im Konto eindeutig)
  "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "7301", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
